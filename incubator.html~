<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="google-site-verification" content="ak4lF8yGJC_b3QU0Gm7VK7W2x1DvZq3Kp-WSqfQEinA" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Institute for Strategic AI | UNE</title>
    <!-- SEO and Primary Meta Tags -->
    <meta name="description" content="The Institute for Strategic AI (ISA) bridges advanced artificial intelligence with real-world application. We build predictive, generative, and agentic AI for autonomous research and scientific discovery.">
    <meta name="keywords" content="Institute for Strategic AI, Agentic AI, Autonomous Research, Scientific Discovery, Predictive Analytics, AI in Chemistry">
    <meta name="author" content="Amir Karton & Aaron Driver">
    <meta name="theme-color" content="#050505">

    <!-- Open Graph / LinkedIn / Facebook Preview -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://theisa.ai/">
    <meta property="og:title" content="Institute for Strategic AI">
    <meta property="og:description" content="Operating at the frontier of applied agentic AI. Bridging advanced artificial intelligence with real-world application.">
    <meta property="og:image" content="https://theisa.ai/images/og-image.png"> 

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://theisa.ai/">
    <meta name="twitter:title" content="Institute for Strategic AI">
    <meta name="twitter:description" content="Operating at the frontier of applied agentic AI. Bridging advanced artificial intelligence with real-world application.">
    <meta name="twitter:image" content="https://theisa.ai/images/og-image.png"> 
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Papa Parse -->
    <script src="/chat/cdn/papaparse.min.js"></script>

    <!-- UI Styles -->
    <style>
        /* Smooth scrolling */
        html { scroll-behavior: smooth; }
        
        /* Hardware accelerated transitions for sections */
        .section-animate {
            transition: opacity 1s ease-out, transform 1s ease-out;
        }
        
        /* Subtle Computational Gridlines Overlay */
        .grid-overlay {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        }

        /* Sleek, clinical dark mode styling matching ISA aesthetics */
        :root {
            --bg-color: #050505;
            --accent-indigo: #818cf8;
            --bento-bg: rgba(255, 255, 255, 0.03);
            --bento-border: rgba(255, 255, 255, 0.1);
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --success-green: #34d399;
        }
        
        .incubator-wrapper {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: inherit;
            padding: 40px 20px;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        .bento-grid {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 24px;
            max-width: 1100px;
            width: 100%;
        }

        .bento-box {
            background: var(--bento-bg);
            border: 1px solid var(--bento-border);
            border-radius: 16px;
            padding: 30px;
            backdrop-filter: blur(8px);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }

        @media (max-width: 800px) {
            .bento-grid { grid-template-columns: 1fr; }
        }

        .status-text { text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem; color: var(--accent-indigo); margin-bottom: 10px; display: block; font-weight: bold;}
        .impact-capital { font-size: 2.5rem; font-family: monospace; color: var(--success-green); font-weight: bold; }
        
        .pitch-input {
            width: 100%;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--accent-indigo);
            color: white;
            padding: 15px;
            border-radius: 8px;
            font-size: 1rem;
            margin-top: 15px;
            resize: vertical;
            min-height: 100px;
        }
        .pitch-input:focus { outline: none; box-shadow: 0 0 10px rgba(129, 140, 248, 0.3); }

        .submit-btn {
            background: var(--accent-indigo);
            color: #000;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 15px;
            transition: all 0.2s;
        }
        .submit-btn:hover { background: #6366f1; transform: translateY(-2px); }
        .submit-btn:disabled { background: #374151; cursor: not-allowed; transform: none; }

        .ai-mentor-box { border-color: var(--accent-indigo); background: rgba(129, 140, 248, 0.05); }
        .hidden { display: none !important; }
    </style>

    <!-- SCRIPT 1: TAILWIND CSS CONFIGURATION -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        isai: {
                            base: '#080808',
                            heading: '#e2e8f0',
                            body: '#cbd5e1', 
                            border: '#1f1f1f',
                            accent: '#818cf8',
                            bento: 'rgba(20, 20, 22, 0.75)'
                        }
                    },
                    backgroundImage: {
                        'hero-grad': 'radial-gradient(circle at 50% 0%, #15151a 0%, #080808 70%)',
                        'pillars-grad': 'radial-gradient(circle at 100% 50%, #0d121c 0%, #080808 80%)',
                        'flagship-grad': 'radial-gradient(circle at 0% 100%, #170d1c 0%, #080808 80%)',
                        'team-grad': 'radial-gradient(circle at 50% 50%, #0a1114 0%, #080808 100%)',
                    }
                }
            }
        }
    </script>
</head>
<body>
    <div class="incubator-wrapper">
        <div class="bento-grid">
            <!-- LEFT COLUMN: The Interface -->
            <div class="main-column" style="display: flex; flex-direction: column; gap: 24px;">
                
                <!-- Context Box -->
                <div class="bento-box">
                    <span class="status-text" id="ui-stage-title">Loading Parameters...</span>
                    <p id="ui-context" style="color: var(--text-muted); margin-bottom: 20px;">Establishing connection to Incubator...</p>
                    <div style="border-left: 3px solid var(--accent-indigo); padding-left: 15px;">
                        <strong style="color: white;">CHALLENGE:</strong>
                        <p id="ui-challenge" style="font-weight: 500;"></p>
                    </div>
                </div>

                <!-- Entrepreneur Mentor Response Box -->
                <div class="bento-box ai-mentor-box hidden" id="ui-response-box">
                    <span class="status-text" style="color: white;">❯ ENTREPRENEUR MENTOR</span>
                    <p id="ui-mentor-reply" style="font-style: italic; line-height: 1.6;"></p>
                    <button id="next-stage-btn" class="submit-btn hidden" style="background: var(--success-green); width: 100%; margin-top: 20px;">Proceed to Next Stage ❯</button>
                </div>

                <!-- Pitch Box -->
                <div class="bento-box" id="ui-pitch-container">
                    <span class="status-text">❯ YOUR STRATEGY</span>
                    <textarea id="ui-pitch-input" class="pitch-input" placeholder="Formulate your pitch to the Investor here..." maxlength="800"></textarea>
<div id="char-counter" style="text-align: right; color: var(--text-muted); font-size: 0.8rem; margin-top: 8px;">0 / 800</div>
                    <button id="ui-submit-btn" class="submit-btn">Submit Pitch to Entrepreneur Mentor</button>
                </div>
                
                <!-- Victory Box -->
                <div class="bento-box hidden" id="ui-victory-box" style="text-align: center; border-color: var(--success-green);">
                    <h2 style="color: var(--success-green); font-size: 2rem;">INCUBATION COMPLETE</h2>
                    <p>You have proven the mindset of a true Entrepreneur.</p>
                </div>

            </div>

            <!-- RIGHT COLUMN: HUD & Stats -->
            <div class="side-column">
                <div class="bento-box" style="position: sticky; top: 20px;">
                    <span class="status-text">Impact Capital Raised</span>
                    <div class="impact-capital" id="ui-capital">$0</div>
                    <hr style="border-color: var(--bento-border); margin: 20px 0;">
                    <span class="status-text">Project Status</span>
                    <p style="font-size: 0.9rem; color: var(--text-muted);">
                        Seed Stage: <span id="ui-stage-tracker" style="color: white; font-weight: bold;">1/10</span><br>
                        Evaluation: <span style="color: var(--accent-indigo);">UNE-SRI Mentor</span>
                    </p>
                </div>
            </div>
        </div>
    </div>

<!-- SCRIPT 2: GAME LOGIC V2 (DYNAMIC NARRATIVE) -->
<script>
    // --- SYSTEM SECURITY LOCK ---
    let gamePasscode = prompt("SYSTEM LOCK: Please enter the authorized Game Passcode:");
    if (!gamePasscode) {
        alert("Warning: Passcode required to interact with the Entrepreneur Mentor.");
    }
    // ----------------------------            
    
    // Frontend Game State
    let currentStage = 0;
    let totalCapital = 0;
    let chatHistory = []; // V2: Stores AI memory

    // V2: Only the first stage is hardcoded. The rest are generated by the LLM!
    let currentContextText = "The local park is covered in litter and the playground equipment is broken. Most people are just complaining about it.";
    let currentChallengeText = "As an Entrepreneur, what action can you take to turn this problem into an opportunity?";

    const levelTitles = [
        "Stage 1: Identifying Community Needs", "Stage 2: User-Centric Design", "Stage 3: Human Authenticity", 
        "Stage 4: Defeating Digital Distractions", "Stage 5: Managing Data Ethics", "Stage 6: The Pivot", 
        "Stage 7: Unique Value Proposition", "Stage 8: Product Quality over Hype", "Stage 9: Founder Wellbeing", 
        "Stage 10: The Smart Region Incubator"
    ];

    // DOM Elements
    const eTitle = document.getElementById('ui-stage-title');
    const eContext = document.getElementById('ui-context');
    const eChallenge = document.getElementById('ui-challenge');
    const eCapital = document.getElementById('ui-capital');
    const eTracker = document.getElementById('ui-stage-tracker');
    const ePitchInput = document.getElementById('ui-pitch-input');
    const eCharCounter = document.getElementById('char-counter');
    const eSubmitBtn = document.getElementById('ui-submit-btn');
    const eResponseBox = document.getElementById('ui-response-box');
    const eMentorReply = document.getElementById('ui-mentor-reply');
    const eNextBtn = document.getElementById('next-stage-btn');
    const ePitchContainer = document.getElementById('ui-pitch-container');
    const eVictoryBox = document.getElementById('ui-victory-box');

    // Live update the character counter as they type
    ePitchInput.addEventListener('input', () => {
    eCharCounter.innerText = `${ePitchInput.value.length} / 800`;
});

    function loadStage() {
        if (currentStage >= 10) {
            ePitchContainer.classList.add('hidden');
            eVictoryBox.classList.remove('hidden');
            return;
        }
        eTitle.innerText = levelTitles[currentStage];
        eContext.innerText = currentContextText;
        eChallenge.innerText = currentChallengeText;
        eTracker.innerText = `${currentStage + 1}/10`;
        eResponseBox.classList.add('hidden');
        eNextBtn.classList.add('hidden');
        ePitchContainer.classList.remove('hidden');
        eMentorReply.style.color = "var(--text-main)";
        ePitchContainer.classList.remove('hidden');
        eMentorReply.style.color = "var(--text-main)";
        
        ePitchInput.value = "";
        eCharCounter.innerText = "0 / 800";
    }

    eSubmitBtn.addEventListener('click', async () => {
        const pitchText = ePitchInput.value.trim();
        if (!pitchText) return;

        // UI Loading State
        eSubmitBtn.disabled = true;
        eSubmitBtn.innerText = "Evaluating via LLM...";
        eResponseBox.classList.add('hidden');

        try {
            // Call the Netlify Function with History Payload
            const res = await fetch('/.netlify/functions/incubator', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    stage_index: currentStage, 
                    pitch: pitchText,
                    current_context: currentContextText,
                    current_challenge: currentChallengeText,
                    history: chatHistory,
                    passcode: gamePasscode 
                })
            });

            if (!res.ok) throw new Error("Connection failed or unauthorized.");
            const data = await res.json();

            // Display Mentor Response
            eResponseBox.classList.remove('hidden');
            eMentorReply.innerText = data.mentor_reply;

            // Save conversation to memory so AI maintains context
            chatHistory.push({ role: "user", content: pitchText });
            chatHistory.push({ role: "assistant", content: data.mentor_reply });

            if (data.is_funded) {
                // MOVE THE CLEARING ACTION HERE!
                ePitchInput.value = ""; 
                eCharCounter.innerText = "0 / 800";

                eMentorReply.style.color = "var(--success-green)";

            // Save conversation to memory so AI maintains context
            chatHistory.push({ role: "user", content: pitchText });
            chatHistory.push({ role: "assistant", content: data.mentor_reply });

            if (data.is_funded) {
                eMentorReply.style.color = "var(--success-green)";
                eMentorReply.innerHTML = `<strong>[ SEED FUNDING APPROVED ]</strong><br><br>` + eMentorReply.innerHTML;
                totalCapital += data.funding_amount;
                eCapital.innerText = "$" + totalCapital.toLocaleString();
                
                // Inject the AI-generated scenario for the next stage
                if (currentStage < 9) {
                    currentContextText = data.next_context;
                    currentChallengeText = data.next_challenge;
                }
                
                // Transition UI
                ePitchContainer.classList.add('hidden');
                eNextBtn.classList.remove('hidden');
            } else {
                eMentorReply.style.color = "var(--accent-indigo)";
            }

        } catch (err) {
            console.error(err);
            eResponseBox.classList.remove('hidden');
            eMentorReply.innerText = "SYSTEM ERROR: Unauthorized or Failed to connect to Entrepreneur Mentor.";
            eMentorReply.style.color = "#ef4444";
        }

        eSubmitBtn.disabled = false;
        eSubmitBtn.innerText = "Submit Pitch to Entrepreneur Mentor";
    });

    eNextBtn.addEventListener('click', () => {
        currentStage++;
        loadStage();
    });

    // Init
    loadStage();
</script>
</body>
</html>
