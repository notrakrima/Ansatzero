<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Academic Profile Engine | ISA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        isai: {
                            base: '#080808',
                            heading: '#e2e8f0',
                            body: '#cbd5e1',
                            border: '#1f1f1f',
                            accent: '#818cf8',
                            bento: 'rgba(20, 20, 22, 0.75)'
                        }
                    },
                    backgroundImage: {
                        'hero-grad': 'radial-gradient(circle at 50% 0%, #15151a 0%, #080808 70%)',
                    }
                }
            }
        }
    </script>
    <style>
        html { scroll-behavior: smooth; }
        .grid-overlay {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        }
        .spinner {
            border: 3px solid rgba(255,255,255,0.1);
            border-top-color: #818cf8;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-isai-base text-isai-body font-sans antialiased min-h-screen relative selection:bg-isai-accent selection:text-white">
    <div class="fixed inset-0 -z-20 bg-hero-grad"></div>
    <div class="fixed inset-0 -z-10 bg-transparent grid-overlay"></div>

    <nav class="fixed top-0 w-full h-[60px] flex items-center justify-between px-8 bg-[#080808]/75 backdrop-blur-md border-b border-isai-border z-50">
        <a href="index.html" class="font-semibold tracking-wide flex items-center gap-3">
            <span class="text-isai-accent">ISA Profile Engine</span>                
        </a>                
    </nav>

    <main class="pt-[100px] pb-24 max-w-5xl mx-auto px-6">
        
        <div id="search-pane" class="bg-isai-bento border border-isai-border rounded-xl p-8 backdrop-blur-md shadow-xl mb-8">
            <h1 class="text-2xl text-isai-heading font-medium mb-4">Generate Academic Profile</h1>
            <div class="flex gap-4">
                <input type="text" id="author-input" placeholder="Enter Author Name (e.g. Marie Curie)" class="flex-1 bg-black/50 border border-isai-border rounded-md px-4 py-2 focus:outline-none focus:border-isai-accent text-isai-heading transition-colors" onkeydown="if(event.key === 'Enter') startSearch()">
                <button onclick="startSearch()" class="bg-isai-accent text-black px-6 py-2 rounded-md font-semibold hover:bg-white transition-colors">Search</button>
            </div>
        </div>

        <div id="loading-pane" class="hidden text-center py-12">
            <div id="loading-spinner" class="spinner mx-auto mb-4"></div>
            <p id="loading-text" class="text-isai-accent animate-pulse">Initializing search...</p>
        </div>

        <div id="selection-pane" class="hidden bg-isai-bento border border-isai-border rounded-xl p-8 backdrop-blur-md shadow-xl mb-8">
            <h2 class="text-xl text-isai-heading font-medium mb-4" id="selection-title">Select Author Profile</h2>
            <div id="candidates-list" class="space-y-3"></div>
        </div>

        <div id="results-pane" class="hidden space-y-8">
            
            <div class="bg-isai-bento border border-isai-border rounded-xl p-8 backdrop-blur-md shadow-xl">
                <h2 id="res-name" class="text-3xl text-isai-heading font-bold mb-1"></h2>
                <p id="res-inst" class="text-isai-accent text-lg mb-6"></p>

                <div class="grid grid-cols-3 gap-4 mb-8">
                    <div class="bg-black/40 border border-isai-border rounded-lg p-4 text-center">
                        <div id="res-cites" class="text-3xl text-isai-heading font-bold"></div>
                        <div class="text-xs uppercase tracking-widest mt-1">Citations</div>
                    </div>
                    <div class="bg-black/40 border border-isai-border rounded-lg p-4 text-center">
                        <div id="res-h" class="text-3xl text-isai-heading font-bold"></div>
                        <div class="text-xs uppercase tracking-widest mt-1">h-index</div>
                    </div>
                    <div class="bg-black/40 border border-isai-border rounded-lg p-4 text-center">
                        <div id="res-i10" class="text-3xl text-isai-heading font-bold"></div>
                        <div class="text-xs uppercase tracking-widest mt-1">i10-index</div>
                    </div>
                </div>

                <div class="mb-6">
                    <h3 class="text-sm uppercase tracking-widest text-isai-heading mb-3 border-b border-isai-border pb-2">Core Expertise</h3>
                    <div id="res-concepts" class="flex flex-wrap gap-2"></div>
                </div>

                <div>
                    <h3 class="text-sm uppercase tracking-widest text-isai-heading mb-3 border-b border-isai-border pb-2">Key Collaborators</h3>
                    <div id="res-collabs" class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm text-isai-body"></div>
                </div>
            </div>

            <div class="bg-isai-bento border border-isai-border rounded-xl p-8 backdrop-blur-md shadow-xl">
                <h3 class="text-lg font-medium text-isai-heading mb-4">H-Index Core Papers</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead>
                            <tr class="border-b border-isai-border">
                                <th class="pb-2 text-isai-heading w-20">Cites</th>
                                <th class="pb-2 text-isai-heading w-20">Year</th>
                                <th class="pb-2 text-isai-heading">Title</th>
                            </tr>
                        </thead>
                        <tbody id="res-core-papers"></tbody>
                    </table>
                </div>
            </div>

            <div class="bg-isai-bento border border-isai-border rounded-xl p-8 backdrop-blur-md shadow-xl" id="close-papers-container">
                <h3 class="text-lg font-medium text-isai-heading mb-4">Papers Approaching H-Core</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead>
                            <tr class="border-b border-isai-border">
                                <th class="pb-2 text-isai-heading w-20">Cites</th>
                                <th class="pb-2 text-isai-heading w-20">Year</th>
                                <th class="pb-2 text-isai-heading">Title</th>
                            </tr>
                        </thead>
                        <tbody id="res-close-papers"></tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

