        const emailParam = "&mailto=amir.karton@une.edu.au";
        
        function el(id) { return document.getElementById(id); }
        function hideAll() {
            el('loading-pane').classList.add('hidden');
            el('selection-pane').classList.add('hidden');
            el('results-pane').classList.add('hidden');
        }

        function showLoading(msg) {
            hideAll();
            el('loading-pane').classList.remove('hidden');
            el('loading-spinner').classList.remove('hidden');
            el('loading-text').classList.add('animate-pulse', 'text-isai-accent');
            el('loading-text').classList.remove('text-red-400');
            el('loading-text').innerText = msg;
        }

        function showError(msg) {
            el('loading-spinner').classList.add('hidden');
            el('loading-text').classList.remove('animate-pulse', 'text-isai-accent');
            el('loading-text').classList.add('text-red-400');
            el('loading-text').innerText = msg;
        }

        async function startSearch() {
            const query = el('author-input').value.trim();
            if (!query) return;
            
            showLoading(`Searching for '${query}'...`);

            try {
                const searchUrl = `https://api.openalex.org/authors?search=${encodeURIComponent(query)}${emailParam}`;
                const res = await fetch(searchUrl);
                const data = await res.json();
                
                const candidates = (data.results || []).filter(r => r.orcid).slice(0, 10);
                
                if (candidates.length === 0) {
                    showError(`No ORCID linked profiles found for '${query}'.`);
                    return;
                }

                el('loading-text').innerText = `Cross-referencing ${candidates.length} profile(s)...`;
                renderSelection(candidates);
                
            } catch (err) {
                console.error(err);
                showError("An error occurred during search. Check console for details.");
            }
        }

        async function renderSelection(candidates) {
            const list = el('candidates-list');
            list.innerHTML = '';
            
            const candidateData = await Promise.all(candidates.map(async (c) => {
                const name = c.display_name || "Unknown";
                const orcid = c.orcid ? c.orcid.split('/').pop() : "";
                let instName = "Unknown Institution";

                if (orcid) {
                    try {
                        const empRes = await fetch(`https://pub.orcid.org/v3.0/${orcid}/employments`, { headers: { "Accept": "application/json" } });
                        if (empRes.ok) {
                            const empData = await empRes.json();
                            const groups = empData['affiliation-group'] || [];
                            if (groups.length > 0 && groups[0].summaries && groups[0].summaries.length > 0) {
                                const org = groups[0].summaries[0]['employment-summary']?.organization;
                                if (org && org.name) { instName = org.name; }
                            }
                        }
                    } catch(e) {}
                }

                if (instName === "Unknown Institution") {
                    if (c.last_known_institutions && c.last_known_institutions.length > 0) {
                        instName = c.last_known_institutions[0].display_name;
                    } else if (c.affiliations && c.affiliations.length > 0 && c.affiliations[0].institution) {
                        instName = c.affiliations[0].institution.display_name;
                    }
                }

                return { c, name, orcid, instName };
            }));

            hideAll();
            el('selection-pane').classList.remove('hidden');
            el('selection-title').innerText = `Identified ${candidateData.length} possible ORCIDs:`;

            for (let item of candidateData) {
                const btn = document.createElement('button');
                btn.className = "w-full text-left bg-black/40 hover:bg-black p-4 rounded-md border border-isai-border hover:border-isai-accent transition-all flex items-center justify-between group mb-3";
                btn.innerHTML = `
                    <div>
                        <div class="text-isai-heading font-bold">${item.name} <span class="text-isai-body font-normal ml-2 text-xs opacity-75">${item.orcid}</span></div>
                        <div class="text-sm text-isai-body mt-1">${item.instName}</div>
                    </div>
                    <div class="text-isai-accent opacity-0 group-hover:opacity-100 transition-opacity">&rarr;</div>
                `;
                btn.onclick = () => processCandidate(item.c);
                list.appendChild(btn);
            }
        }

        async function processCandidate(candidate) {
            showLoading(`Fetching verified DOIs from ORCID...`);
            
            const orcidId = candidate.orcid.split('/').pop();
            const oaId = candidate.id.split('/').pop();
            const authorName = candidate.display_name;

            const dois = new Set();
            try {
                const oRes = await fetch(`https://pub.orcid.org/v3.0/${orcidId}/works`, { headers: { "Accept": "application/json" } });
                if (oRes.ok) {
                    const oData = await oRes.json();
                    for (let g of (oData.group || [])) {
                        for (let ws of (g['work-summary'] || [])) {
                            const extCont = ws['external-ids'];
                            if (extCont && extCont['external-id']) {
                                for (let ext of extCont['external-id']) {
                                    if (ext['external-id-type'] === 'doi') {
                                        let d = ext['external-id-value'].toLowerCase().trim();
                                        d = d.replace('https://doi.org/', '').replace('http://doi.org/', '');
                                        dois.add(d);
                                        break;
                                    }
                                }
                            }
                        }
                    }
                }
            } catch (err) { console.error(err); }

            let works = [];
            let allWorks = {};
            const doiArray = Array.from(dois);

            el('loading-text').innerText = `Analyzing OpenAlex datasets for ${doiArray.length || "all"} works...`;

            if (doiArray.length > 0) {
                const chunkSize = 25;
                for (let i = 0; i < doiArray.length; i += chunkSize) {
                    const chunk = doiArray.slice(i, i + chunkSize);
                    const queryFilter = chunk.map(d => `https://doi.org/${encodeURIComponent(d)}`).join("|");
                    const url = `https://api.openalex.org/works?filter=doi:${queryFilter}&per-page=200${emailParam}`;
                    
                    try {
                        const wRes = await fetch(url);
                        if (wRes.ok) {
                            const wData = await wRes.json();
                            for (let w of (wData.results || [])) allWorks[w.id] = w;
                        } else {
                            throw new Error("Chunk fail");
                        }
                    } catch (e) { 
                        for (let d of chunk) {
                            try {
                                const singleUrl = `https://api.openalex.org/works?filter=doi:https://doi.org/${encodeURIComponent(d)}${emailParam}`;
                                const sRes = await fetch(singleUrl);
                                if (sRes.ok) {
                                    const sData = await sRes.json();
                                    for (let w of (sData.results || [])) allWorks[w.id] = w;
                                }
                            } catch(ex) {}
                        }
                    }
                }
                works = Object.values(allWorks);
            } else {
                let cursor = "*";
                while (cursor) {
                    const url = `https://api.openalex.org/works?filter=author.id:${oaId}&per-page=200&cursor=${encodeURIComponent(cursor)}${emailParam}`;
                    try {
                        const r = await fetch(url);
                        const d = await r.json();
                        if (d.results && d.results.length > 0) {
                            works.push(...d.results);
                            cursor = d.meta.next_cursor;
                            if (works.length >= 2000) break;
                        } else { break; }
                    } catch (e) { break; }
                }
            }

            el('loading-text').innerText = "Generating Advanced Analytics...";
            
            const sortedByCites = [...works].sort((a,b) => (b.cited_by_count||0) - (a.cited_by_count||0));
            const totalCites = sortedByCites.reduce((acc, w) => acc + (w.cited_by_count||0), 0);
            const i10 = sortedByCites.filter(w => (w.cited_by_count||0) >= 10).length;
            let hIndex = 0;
            for (let i = 0; i < sortedByCites.length; i++) {
                if ((sortedByCites[i].cited_by_count || 0) > i) hIndex++;
                else break;
            }

            const sortedByDate = [...works].sort((a,b) => (b.publication_date || "1900-01-01").localeCompare(a.publication_date || "1900-01-01"));
            const recentInsts = [];
            for (let w of sortedByDate.slice(0,10)) {
                for (let auth of (w.authorships||[])) {
                    if (auth.author && auth.author.id && (auth.author.id.endsWith(oaId) || (orcidId && auth.author.orcid && auth.author.orcid.includes(orcidId)))) {
                        for (let inst of (auth.institutions||[])) {
                            if(inst.display_name) recentInsts.push(inst.display_name);
                        }
                    }
                }
            }
            let instDisplay = "Unknown Institution";
            if (recentInsts.length > 0) {
                const countMap = {};
                let maxCt = 0;
                for (let r of recentInsts) {
                    countMap[r] = (countMap[r]||0) + 1;
                    if(countMap[r] > maxCt) { maxCt = countMap[r]; instDisplay = r; }
                }
            }

            const conceptCounts = {};
            const collabCounts = {};
            const idToName = {};
            const countrySet = new Set();
            const level0Concepts = {};
            let yearlyTimeline = {};
            const currentYear = new Date().getFullYear();

            for (let w of works) {
                for (let yr_data of (w.counts_by_year || [])) {
                    yearlyTimeline[yr_data.year] = (yearlyTimeline[yr_data.year] || 0) + yr_data.cited_by_count;
                }

                for (let c of (w.concepts||[])) {
                    if ((c.level||0) >= 2 && (c.score||0) > 0.4) {
                        let cn = (c.display_name||"").replace(/\s*\([^)]*\)/g, '').trim().toLowerCase();
                        if (cn) conceptCounts[cn] = (conceptCounts[cn]||0) + 1;
                    }
                    if (c.level === 0 && (c.score||0) > 0.3) {
                        level0Concepts[c.display_name] = (level0Concepts[c.display_name]||0) + 1;
                    }
                }

                for (let auth of (w.authorships||[])) {
                    if (auth.institutions && auth.institutions.length > 0) {
                        for(let inst of auth.institutions) {
                            if(inst.country_code) countrySet.add(inst.country_code);
                        }
                    }

                    const mAuthor = auth.author;
                    if (!mAuthor || !mAuthor.id) continue;
                    let isMain = false;
                    if (orcidId && mAuthor.orcid && mAuthor.orcid.includes(orcidId)) isMain = true;
                    else if (mAuthor.id.endsWith(oaId)) isMain = true;

                    if (!isMain) {
                        idToName[mAuthor.id] = mAuthor.display_name || "Unknown";
                        collabCounts[mAuthor.id] = (collabCounts[mAuthor.id]||0) + 1;
                    }
                }
            }

            const topConcepts = Object.entries(conceptCounts).sort((a,b) => b[1]-a[1]).slice(0,30).map(kv=>kv[0]);
            const topCollabs = Object.entries(collabCounts).sort((a,b) => b[1]-a[1]).slice(0,30).map(kv=>idToName[kv[0]]);
            const macros = Object.entries(level0Concepts).sort((a,b) => b[1]-a[1]);

            const velocityPapers = works.map(w => {
                let recent = (w.counts_by_year||[]).filter(y => y.year >= (currentYear - 2)).reduce((sum, y) => sum + y.cited_by_count, 0);
                return { title: w.title, citeCount: recent, year: w.publication_year };
            }).filter(p => p.citeCount > 0).sort((a,b) => b.citeCount - a.citeCount).slice(0, 30);

            // BATCH FETCH: Get actual Impact stats for all unique journals the author published in
            const uniqueSourceIds = [...new Set(works.map(w => w.primary_location?.source?.id).filter(id => id))];
            const sourceMap = {}; 
            
            if (uniqueSourceIds.length > 0) {
                const sourceChunks = [];
                for (let i = 0; i < uniqueSourceIds.length; i += 40) { // OpenAlex allows max 50 queries in one string
                    sourceChunks.push(uniqueSourceIds.slice(i, i + 40));
                }
                
                // Fetch chunks in parallel so it doesn't slow down the tool
                await Promise.all(sourceChunks.map(async (chunk) => {
                    try {
                        const filterStr = chunk.map(id => id.split('/').pop()).join('|');
                        const url = `https://api.openalex.org/sources?filter=openalex:${filterStr}&per-page=200${emailParam}`;
                        const res = await fetch(url);
                        const data = await res.json();
                        for (let s of (data.results || [])) {
                            sourceMap[s.id] = s.summary_stats?.['2yr_mean_citedness'] || 0;
                        }
                    } catch(e) { console.error("Source chunk error", e); }
                }));
            }

            const ifPapers = works.map(w => {
                let srcId = w.primary_location?.source?.id;
                let jn = w.primary_location?.source?.display_name || "Unknown Journal";
                let mc2y = sourceMap[srcId] || 0;
                return { title: w.title, journal: jn, iff: mc2y, year: w.publication_year };
            }).filter(p => p.iff > 0).sort((a,b) => b.iff - a.iff).slice(0, 30);

            renderDashboard({
                name: authorName, inst: instDisplay, cites: totalCites, h: hIndex, i10: i10,
                concepts: topConcepts, collabs: topCollabs, papers: sortedByCites,
                countries: Array.from(countrySet), macros: macros,
                velocity: velocityPapers, ifPapers: ifPapers
            });
        }

        function renderDashboard(data) {
            hideAll();
            el('results-pane').classList.remove('hidden');

            el('res-name').innerText = data.name;
            el('res-inst').innerText = data.inst;
            el('res-cites').innerText = data.cites;
            el('res-h').innerText = data.h;
            el('res-i10').innerText = data.i10;

            el('res-concepts').innerHTML = data.concepts.map(c => `<span class="bg-black border border-isai-accent/30 text-isai-heading px-3 py-1 rounded-full text-xs capitalize">${c}</span>`).join('') || "None";
            el('res-collabs').innerHTML = data.collabs.map(c => `<div class="truncate">&bull; ${c}</div>`).join('') || "None";

            const pCore = el('res-core-papers'); pCore.innerHTML = '';
            for (let i = 0; i < data.h; i++) {
                if (!data.papers[i]) break;
                pCore.innerHTML += `<tr class="border-b border-isai-border/50 hover:bg-black/40"><td class="py-3 font-bold text-isai-accent">${data.papers[i].cited_by_count||0}</td><td class="py-3">${data.papers[i].publication_year||'N/A'}</td><td class="py-3 font-normal text-sm">${data.papers[i].title||'Untitled'}</td></tr>`;
            }

            const pClose = el('res-close-papers'); pClose.innerHTML = '';
            if (data.papers.length > data.h) {
                el('close-papers-container').classList.remove('hidden');
                for (let i = data.h; i < Math.min(data.h + 10, data.papers.length); i++) {
                    pClose.innerHTML += `<tr class="border-b border-isai-border/50 hover:bg-black/40"><td class="py-3 font-bold text-isai-accent">${data.papers[i].cited_by_count||0}</td><td class="py-3">${data.papers[i].publication_year||'N/A'}</td><td class="py-3 font-normal text-sm">${data.papers[i].title||'Untitled'}</td></tr>`;
                }
            } else el('close-papers-container').classList.add('hidden');

            let totalMacro = data.macros.reduce((sum, m) => sum + m[1], 0);
            el('res-diversity').innerHTML = data.macros.slice(0,5).map(m => {
                let pct = Math.round((m[1]/totalMacro)*100);
                return `<div><div class="flex justify-between text-xs mb-1"><span>${m[0]}</span><span class="text-isai-accent">${pct}%</span></div><div class="w-full bg-black rounded-full h-1.5"><div class="bg-isai-accent h-1.5 rounded-full" style="width: ${pct}%"></div></div></div>`;
            }).join('') || "Not available";

            el('res-velocity-papers').innerHTML = data.velocity.length === 0 ? "<tr><td colspan='3' class='py-4 italic'>No recent citation bursts detected.</td></tr>" : data.velocity.map(w => `<tr class="border-b border-isai-border/50 hover:bg-black/40"><td class="py-3 font-bold text-green-400">+${w.citeCount}</td><td class="py-3">${w.year}</td><td class="py-3 font-normal text-xs md:text-sm">${w.title}</td></tr>`).join('');
            
            el('res-if-papers').innerHTML = data.ifPapers.length === 0 ? "<tr><td colspan='3' class='py-4 italic'>No available journal statistics.</td></tr>" : data.ifPapers.map(w => `<tr class="border-b border-isai-border/50 hover:bg-black/40"><td class="py-3 font-bold text-isai-accent">${w.iff.toFixed(1)}</td><td class="py-3 text-xs uppercase tracking-wider text-green-400/80">${w.journal}</td><td class="py-3 font-normal text-xs md:text-sm pl-2">${w.title}</td></tr>`).join('');
        }
