<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Institute for Strategic AI</title>
    <style>
        /* Base Aesthetic */
        body, html {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #050505;
            color: #ededed;
            overflow-x: hidden;
        }

        /* Fixed Background Layer for Scrollytelling Transitions */
        #fixed-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            /* The default background */
            background-color: #050505; 
            /* This transition creates the smooth crossfade effect! */
            transition: background 1.5s ease-in-out;
        }

        /* Gradient Color States mapping to data-bg tags */
        .bg-hero { background: radial-gradient(circle at center, #161616 0%, #050505 100%); }
        .bg-vision { background: radial-gradient(circle at top right, #0a1128 0%, #050505 100%); }
        .bg-stealth { background: radial-gradient(circle at bottom left, #1a0f14 0%, #050505 100%); }
        .bg-capture { background: #050505; }

        /* Scrollable Content Sections */
        .section {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 4rem 2rem;
            text-align: center;
            /* Set up slideUp/fadeIn animation starting point */
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 1.2s cubic-bezier(0.2, 0.8, 0.2, 1), transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        /* Class applied by JS when section is scrolled into view */
        .section.in-view {
            opacity: 1;
            transform: translateY(0);
        }

        /* Typography */
        h1 {
            font-size: 3.5rem;
            font-weight: 600;
            letter-spacing: -0.03em;
            margin-bottom: 1.2rem;
            background: linear-gradient(90deg, #ffffff, #a0a0a0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        p {
            font-size: 1.25rem;
            color: #a0a0a0;
            max-width: 650px;
            line-height: 1.7;
            margin-bottom: 2rem;
        }

        /* Simple Netlify Form styling matching your aesthetic */
        .form-container {
            display: flex;
            gap: 0.5rem;
            margin-top: 2rem;
        }

        input[type="email"] {
            background-color: #111111;
            border: 1px solid #333333;
            color: #ededed;
            padding: 0.8rem 1.2rem;
            border-radius: 6px;
            font-size: 1rem;
            min-width: 250px;
            outline: none;
            transition: border-color 0.3s;
        }

        input[type="email"]:focus {
            border-color: #666666;
        }

        button {
            background-color: #ededed;
            color: #050505;
            border: none;
            padding: 0.8rem 1.5rem;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.3s;
        }

        button:hover {
            opacity: 0.8;
        }
    </style>
</head>
<body>

    <!-- This is the background layer that sits behind everything and changes color -->
    <div id="fixed-bg" class="bg-hero"></div>

    <!-- Section 1 -->
    <section class="section" data-bg="bg-hero">
        <h1>Institute for Strategic AI</h1>
        <p>A new paradigm in real-world artificial intelligence applications. We design autonomous systems for high-impact enterprise environments.</p>
    </section>

    <!-- Section 2 -->
    <section class="section" data-bg="bg-vision">
        <h1>First-Principles Design</h1>
        <p>Moving beyond conversational tools. Our architecture focuses on stealthy, frictionless integration into complex analytical and logistical workflows.</p>
    </section>

    <!-- Section 3 -->
    <section class="section" data-bg="bg-stealth">
        <h1>Institutional Authority</h1>
        <p>Research-backed deployments bridging the gap between theoretical limits and practical algorithmic efficiency.</p>
    </section>

    <!-- Section 4: Email Capture -->
    <section class="section" data-bg="bg-capture">
        <h1>Operations Stealth</h1>
        <p>We are currently operating in a closed development phase. Leave your email to be informed of our public launch sequence.</p>
        
        <form name="isai-stealth-capture" method="POST" data-netlify="true" class="form-container">
            <input type="email" name="email" placeholder="name@domain.com" required>
            <!-- Netlify reCAPTCHA placeholder could be mapped here if desired later -->
            <button type="submit">Join</button>
        </form>
    </section>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const sections = document.querySelectorAll(".section");
            const fixedBg = document.getElementById("fixed-bg");

            // Setup Intersection Observer
            const observerOptions = {
                root: null,
                rootMargin: "0px",
                threshold: 0.55 // Triggers when 55% of the section is visible vertically in the viewport
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        // 1. Trigger the text FadeIn/SlideUp animation
                        entry.target.classList.add("in-view");
                        
                        // 2. Grab the background class assigned to this specific section
                        const bgClass = entry.target.getAttribute("data-bg");
                        
                        // 3. Apply it to the fixed background to trigger the CSS crossfade
                        fixedBg.className = bgClass;
                    }
                });
            }, observerOptions);

            // Tell the observer to watch all our sections
            sections.forEach(section => {
                observer.observe(section);
            });
        });
    </script>
</body>
</html>
